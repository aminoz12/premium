{
  "version": "1.0.0",
  "policyName": "CDN Caching & Image Delivery Headers Policy",
  "headerDirectives": [
    {
      "assetPattern": "/images/**/*.webp",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Content-Type": "image/webp",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "assetPattern": "/*.webp",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Content-Type": "image/webp",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "assetPattern": "/logo.svg",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Content-Type": "image/svg+xml"
      }
    }
  ]
}
